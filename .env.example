# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b

# Memory Configuration
AGENT_MEMORY_DB=./agent_memory.db

# Image Generation Configuration (for image_generation_agent.py)
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
IMAGE_OUTPUT_DIR=./generated_images
DEVICE=auto
NUM_INFERENCE_STEPS=25
GUIDANCE_SCALE=7.5

# Voice Agent Configuration (for voice_agent.py)
WHISPER_MODEL=base
TTS_VOICE=en-US-AriaNeural
AUDIO_CHUNK=1024
AUDIO_CHANNELS=1
AUDIO_RATE=16000
RECORDING_TIMEOUT=5.0

# Open WebUI Configuration (for run_open_webui.sh)
OPEN_WEBUI_PORT=8080
