# Local LLM Agent Configuration
# Copy this file to .env and customize as needed

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M

# Memory Database (optional - defaults to ./agent_memory.db)
# AGENT_MEMORY_DB=./agent_memory.db

# Image Agent Configuration (optional)
OLLAMA_VISION_MODEL=llava:7b

# Image Generation Agent Configuration (optional)
STABLE_DIFFUSION_MODEL=flux
IMAGE_OUTPUT_DIR=./generated_images
