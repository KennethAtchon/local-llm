{
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local (llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (local)",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "qwen3.8-27b-mlx": {
          "name": "Qwen3.8 27B MLX (local, fastest)",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3-4b": {
          "name": "Qwen3 4B (local)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "gemma-4-e4b": {
          "name": "Gemma 4 E4B (local)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local": {
      "description": "Local Qwen3.8-27B; firecrawl tools excluded (breaks GBNF grammar)",
      "model": "local/qwen3.8-27b",
      "mode": "primary",
      "tools": {
        "firecrawl*": false,
        "playwright*": false,
        "agent-search*": false
      }
    }
  }
}
